# === App ===
APP_SECRET_KEY=change-me-32-chars-minimum-random
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# === Deployment (nginx TLS) ===
# Domain for Let's Encrypt cert path: /etc/letsencrypt/live/${DOMAIN}/
# Defaults to localhost for local dev (no TLS cert needed there).
DOMAIN=localhost

# === Supabase ===
DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[project].supabase.co:5432/postgres
SUPABASE_URL=https://[project].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# === Supabase Auth (frontend) ===
NEXT_PUBLIC_SUPABASE_URL=https://[project].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# === Supabase Auth (backend JWT verification) ===
SUPABASE_JWT_SECRET=

# === Clerk Auth ===
# Clerk handles app login. Supabase remains the database/storage backend.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=https://closing-anchovy-49.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Optional when using a custom Clerk JWT audience.
# CLERK_JWT_AUDIENCE=

# === Redis ===
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=changeme

# === PinchTab ===
PINCHTAB_URL=http://localhost:9867
PINCHTAB_TOKEN=your-pinchtab-token-here

# === CORS (comma-separated list of allowed origins, no wildcards) ===
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# === Internal worker secret (must match INTERNAL_SECRET in worker/.env) ===
INTERNAL_SECRET=change-me-random-secret

# === YouTube Data API (required for interview prep video suggestions) ===
YOUTUBE_API_KEY=

# === Backend ===
BACKEND_URL=http://localhost:8000

# === Resend ===
RESEND_API_KEY=re_...

# === Google OAuth for Gmail token refresh ===
# Must match Google OAuth client configured in Supabase Auth provider.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# === External APIs (optional — users supply their own) ===
# EXA_API_KEY=
