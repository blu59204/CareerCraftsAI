# =============================================================================
# CareerCraft AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in every value marked (REQUIRED).
# Lines prefixed with # are optional — uncomment and set if needed.

# ── App (REQUIRED) ──────────────────────────────────────────────────────────
APP_SECRET_KEY=change-me-32-chars-minimum-random           # (REQUIRED) 32+ char random secret — generate with: openssl rand -hex 32
APP_ENV=development                                        # development | production (production disables /docs)

# ── Database (REQUIRED) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname   # (REQUIRED) self-hosted Postgres — see deploy/oracle for the compose setup

# ── Clerk Auth (REQUIRED) ───────────────────────────────────────────────────
CLERK_ISSUER=https://[your-instance].clerk.accounts.dev     # (REQUIRED) or set CLERK_JWKS_URL directly
CLERK_SECRET_KEY=                                           # (REQUIRED) Clerk Backend API secret key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=                          # (REQUIRED) exposed to Next.js

# ── Redis (REQUIRED) ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379                            # (REQUIRED) connection URL
REDIS_PASSWORD=changeme                                     # (REQUIRED if Redis has auth enabled)

# ── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001 # comma-separated — no wildcards

# ── Internal operator endpoints ─────────────────────────────────────────────
INTERNAL_SECRET=change-me-random-secret                     # (REQUIRED) guards /internal/* manual job triggers

# ── Next.js Public URLs ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000                   # frontend URL as seen by the browser
NEXT_PUBLIC_API_URL=http://localhost:8000                   # backend URL as seen by the browser

# ── Resend (email delivery) ─────────────────────────────────────────────────
RESEND_API_KEY=re_...                                       # from https://resend.com/api-keys

# ── YouTube Data API ────────────────────────────────────────────────────────
YOUTUBE_API_KEY=                                            # from Google Cloud Console — interview prep video suggestions

# ── External API Keys (all optional — features degrade gracefully) ──────────
# HUNTER_API_KEY=           # https://hunter.io/api-keys — find recruiter emails
# PROXYCURL_API_KEY=        # https://nubela.co/proxycurl — LinkedIn profile data
# EXA_API_KEY=              # https://exa.ai — neural web search for research
# AGENTQL_API_KEY=          # https://dev.agentql.com — live-browser job scraping
# FIRECRAWL_API_KEY=        # https://firecrawl.dev — company website scraping
# RAPIDAPI_KEY=             # https://rapidapi.com — JSearch aggregator
# ADZUNA_APP_ID=            # https://developer.adzuna.com — free job API (India coverage)
# ADZUNA_APP_KEY=           # paired with ADZUNA_APP_ID

# ── Search Providers (optional fallbacks) ────────────────────────────────────
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SERPAPI_API_KEY=
# BING_SEARCH_API_KEY=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=
# SEARXNG_URL=http://localhost:8888   # self-hosted meta-search (free, no CAPTCHA)

# ── LLM Gateway ─────────────────────────────────────────────────────────────
# LLM_GATEWAY_URL=http://localhost:8000/llm-gateway/v1

# ── Agent Configuration ─────────────────────────────────────────────────────
# AGENT_DEFAULT_TIMEOUT_S=60              # default agent run timeout
# AGENT_MAX_CONCURRENT_PER_USER=2         # concurrent agent runs per user
# AGENT_THINKING_BUDGET_TOKENS=8000       # Claude extended thinking token budget

# ── Ollama BYOK provider — SSRF allow-list ──────────────────────────────────
# Users can point Settings → AI Models at a self-hosted Ollama; the server
# fetches this URL directly, so only allow-listed host:port pairs are
# accepted. Add your own host here if Ollama doesn't run on localhost.
# OLLAMA_ALLOWED_HOSTS=localhost:11434,127.0.0.1:11434,[::1]:11434

# ── Temporal (REQUIRED) — runs every agent, search, application, follow-up ──
# The API starts workflows; `python -m app.temporal_worker` (the
# temporal-worker service) executes them. With no worker polling the task
# queue nothing runs, and GET /health reports status "degraded".
# Host-run development uses localhost. Docker Compose services use
# TEMPORAL_ADDRESS_DOCKER (default temporal:7233) so they never resolve their
# own localhost. Set the Docker variable to the managed Temporal address when
# using Compose against Temporal Cloud.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_ADDRESS_DOCKER=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=careercraft
TEMPORAL_WORKER_CONCURRENCY=4
WORKFLOW_TASK_TIMEOUT_S=300                 # max duration of one agent execution
AGENT_APPROVAL_TIMEOUT_S=172800             # a checkpoint expires after 48h
TEMPORAL_WORKFLOW_EXECUTION_TIMEOUT_S=600   # server-browser applications only
TEMPORAL_ACTIVITY_START_TO_CLOSE_TIMEOUT_S=120
TEMPORAL_ACTIVITY_HEARTBEAT_TIMEOUT_S=30
TEMPORAL_ACTIVITY_HEARTBEAT_INTERVAL_S=5
# Recurring Schedules the worker registers at start-up.
TEMPORAL_SCHEDULES_ENABLED=true
DAILY_SEARCH_INTERVAL_HOURS=24
STATUS_CHECK_INTERVAL_HOURS=6               # server_browser mode only
MAINTENANCE_INTERVAL_SECONDS=60
# Temporal Cloud mTLS: mount certificate files into API and worker containers.
# Never put certificate contents or private keys in this file.
TEMPORAL_TLS_CERT_PATH=
TEMPORAL_TLS_KEY_PATH=
TEMPORAL_TLS_CA_PATH=

# ── Job applications ───────────────────────────────────────────────────────
# extension      — apply in the user's own browser via the CareerCraft
#                  extension (extension/ in this repo); no server browsers.
# server_browser — isolated OpenSandbox browsers (OPEN_SANDBOX_* below).
APPLY_EXECUTION_MODE=extension
EXTENSION_TASK_CLAIM_TIMEOUT_S=86400        # unclaimed tasks expire after 24h
EXTENSION_TASK_COMPLETE_TIMEOUT_S=7200      # time to review + submit once claimed

# ── Decision engine for in-browser choices (optional) ──────────────────────
# "System One" models answer typed questions (choice / score / noul) in
# milliseconds. auto = Jev if TYPESAFE_API_KEY is set, else Laya if LAYA_URL
# is set, else built-in heuristics.
DECISION_ENGINE_PROVIDER=auto
# TYPESAFE_API_KEY=                         # https://console.typesafe.ai — Jev
# TYPESAFE_MODEL=jev-latest
# LAYA_URL=http://laya:8088                 # self-hosted Laya, see deploy/laya
# LAYA_API_KEY=
DECISION_ENGINE_MIN_CONFIDENCE=0.6

# ── Nango integration gateway ─────────────────────────────────────────────
# NANGO_SECRET_KEY and NANGO_WEBHOOK_SECRET are backend-only secrets. The
# public key is optional with current connect-session frontend flows.
# Gmail/Drive have no direct-OAuth fallback: this must be true, with the
# secrets below set, or those integrations will not work.
NANGO_ENABLED=true
NANGO_BASE_URL=https://api.nango.dev
NANGO_SECRET_KEY=
NANGO_PUBLIC_KEY=
NANGO_WEBHOOK_SECRET=
# JSON object of Nango integration unique keys created in this environment.
# Example: {"gmail":"google-mail-production","google_drive":"google-drive-production"}
NANGO_PROVIDER_CONFIG_KEYS={}
NANGO_REQUEST_TIMEOUT_S=15
# OpenSandbox lifecycle server base URL, WITHOUT /v1 (APPLY_EXECUTION_MODE=
# server_browser only). Must be privately reachable from both the API and the
# Temporal worker, along with the returned sandbox CDP endpoints.
OPEN_SANDBOX_URL=
OPEN_SANDBOX_API_KEY=
OPEN_SANDBOX_CHROME_IMAGE=careercraft-browser:1
SANDBOX_MAX_ACTIVE=4
SANDBOX_TTL_SECONDS=1800
SANDBOX_CPU=1000m
SANDBOX_MEMORY=1024Mi
# Include required portal/CDN/identity domains. Empty fails closed.
# Example only: adapt to the actual portal flow, then test its network policy.
SANDBOX_ALLOWED_DOMAINS=boards.greenhouse.io,job-boards.greenhouse.io,*.greenhouse.io

# ── RAG Configuration ───────────────────────────────────────────────────────
# RAG_CHUNK_SIZE=500                      # document chunk size in tokens
# RAG_CHUNK_OVERLAP=50                    # chunk overlap in tokens
# RAG_TOP_K=5                             # chunks to retrieve per query

# ── Rate Limiting ───────────────────────────────────────────────────────────
# RATE_LIMIT_DEFAULT=60/minute            # default rate limit for API endpoints
# RATE_LIMIT_AGENT_RUN=10/minute          # agent run endpoint rate limit
# RATE_LIMIT_UPLOAD=5/minute              # upload endpoint rate limit
